# Raptor Bot on the Discord server (docs/PANEL.md#discord). Optional:
# skipped until the item "Raptor Bot" exists in the vault (scripts/secrets.sh);
# the bot is off without it. Its application is also Discord sign-in's
# ("Discord OAuth").
PANEL_DISCORD_BOT_TOKEN={{ op://Raptor production/Raptor Bot/token }}
PANEL_DISCORD_PUBLIC_KEY={{ op://Raptor production/Raptor Bot/public_key }}
PANEL_DISCORD_GUILD_ID={{ op://Raptor production/Raptor Bot/guild_id }}
PANEL_DISCORD_CUSTOMER_ROLE={{ op://Raptor production/Raptor Bot/customer_role_id }}
PANEL_DISCORD_SUPPORT_ROLE={{ op://Raptor production/Raptor Bot/support_role_id }}
PANEL_DISCORD_LOG_CHANNEL={{ op://Raptor production/Raptor Bot/log_channel_id }}
