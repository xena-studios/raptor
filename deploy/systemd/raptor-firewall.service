# The firewall at every boot (deploy/scripts/firewall.sh): ufw keeps its own
# rules, but the DOCKER-USER rules limiting 443 to Cloudflare are gone after
# a reboot until this runs.
[Unit]
Description=Raptor firewall (SSH, and 443 from Cloudflare only)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Before=raptor-stack.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/raptor/deploy/scripts/firewall.sh

[Install]
WantedBy=multi-user.target
