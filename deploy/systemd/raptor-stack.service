# Starts the stack at boot: secrets from 1Password into memory, then Compose
# (docs/DEPLOY.md), which reads the server's settings from panel/.env.
[Unit]
Description=Raptor (Panel, Postgres, Caddy)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/raptor/deploy/panel
ExecStartPre=/opt/raptor/deploy/scripts/secrets.sh
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
