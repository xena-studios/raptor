# Stops game servers gracefully when the host shuts down, with each egg's own
# stop command (docs/SERVERS.md#host-shutdown). Installed by `raptor bootstrap`.
#
# Units stop in reverse start order, so being ordered after Docker and Wings
# means this runs first on shutdown, while both are still up. There's
# deliberately no Requires=/PartOf= on raptor-wings: restarting Wings must
# never stop servers.

[Unit]
Description=Raptor: stop game servers gracefully on shutdown
Documentation=https://github.com/xena-studios/raptor
After=docker.service raptor-wings.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/raptor wings shutdown-servers
# Servers stop in parallel, each within its stop timeout (at most 10 minutes).
TimeoutStopSec=15min

[Install]
WantedBy=multi-user.target
