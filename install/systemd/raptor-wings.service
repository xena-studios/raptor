# Raptor Wings daemon. Installed by `raptor bootstrap`.
#
# Stopping or restarting this service never stops game servers: their
# containers belong to Docker, not to this service's cgroup.
#
# /usr/local/bin/raptor links to /usr/local/lib/raptor/current, the active
# version. Self-update installs versions there, exits, and relies on
# Restart=always to be started again; the running version then tries the new
# one as its child and only switches "current" once it's healthy
# (docs/WINGS.md#updates).

[Unit]
Description=Raptor Wings
Documentation=https://github.com/xena-studios/raptor
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=exec
ExecStart=/usr/local/bin/raptor wings run
Restart=always
RestartSec=5
TimeoutStopSec=30

# Game servers can run out of memory; Wings must not be what the kernel kills.
OOMScoreAdjust=-900
LimitNOFILE=65536

# systemd creates these with the right ownership and permissions. Everything
# Wings writes is private to root by default (the socket is opened up to the
# raptor group explicitly).
UMask=0077
RuntimeDirectory=raptor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=raptor
StateDirectoryMode=0700
LogsDirectory=raptor
LogsDirectoryMode=0700
ConfigurationDirectory=raptor
ConfigurationDirectoryMode=0700

# Sandboxing. Wings runs as root (Docker, quotas, nftables), so limit
# everything it doesn't need.
NoNewPrivileges=yes
ProtectSystem=strict
# Self-update writes versions to /usr/local/lib/raptor ("-": not fatal if
# it's missing on an older install; updates then say they're unavailable).
ReadWritePaths=/etc/raptor /var/lib/raptor /var/log/raptor /run/raptor -/usr/local/lib/raptor
# Folder backup destinations: disks and NAS shares mounted where they usually
# are (Wings refuses folders anywhere else).
ReadWritePaths=-/mnt -/media -/srv
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
