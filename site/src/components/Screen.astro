---
// A screenshot of the app (src/assets/screens/<shot>-dark.png and
// -light.png, from scripts/screens.mjs), in the visitor's theme, as WebP
// at the widths a page needs, in a frame like the app's window.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*.png", { eager: true });
const { shot, alt, eager = false } = Astro.props as { shot: string; alt: string; eager?: boolean };
const pick = (theme: string) => shots[`../assets/screens/${shot}-${theme}.png`]?.default;
const dark = pick("dark");
if (!dark) throw new Error(`no screenshot ${shot}-dark.png`);
const light = pick("light");
const widths = [640, 960, 1440, 2160, 2880].filter((w) => w <= dark.width);
const sizes = "(min-width: 76rem) 72rem, 100vw";
const d = await getImage({ src: dark, widths, format: "webp", quality: 82 });
const l = light && (await getImage({ src: light, widths, format: "webp", quality: 82 }));
---
<figure class="screen">
  <div class="screen-bar" aria-hidden="true"><span>app.raptorpanel.net</span></div>
  <picture>
    {l && <source media="(prefers-color-scheme: light)" srcset={l.srcSet.attribute} sizes={sizes} type="image/webp" />}
    <img
      src={d.src}
      srcset={d.srcSet.attribute}
      sizes={sizes}
      width={dark.width}
      height={dark.height}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
    />
  </picture>
</figure>
