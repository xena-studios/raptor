---
// raptorpanel.net's home page: what Raptor is, the library, how a machine
// gets linked, the app, what's new, why it's safe, and the price. Each part
// has a page of its own for the long version (Base's nav).
import GameIcon from "../components/GameIcon.astro";
import Screen from "../components/Screen.astro";
import Base from "../layouts/Base.astro";
import { changelog, longDate } from "../data/changelog";
import { general as faq } from "../data/faq";
import { app, demo, discord, docs, price, start } from "../data/links";
import { categories, byCategory, href, library } from "../lib/library";

const count = library.length;
const floor = Math.floor(count / 50) * 50;

// The wall: games people come for first. Each is a library folder.
const wall = [
  "minecraft/paper", "steam/rust", "steam/valheim", "steam/palworld", "minecraft/fabric", "steam/cs2",
  "steam/satisfactory", "standalone/terraria", "steam/project-zomboid", "minecraft/neoforge", "steam/ark-survival-ascended", "standalone/factorio",
  "steam/enshrouded", "steam/7-days-to-die", "minecraft/bedrock", "steam/v-rising", "steam/gmod", "standalone/vintage-story",
  "standalone/fivem", "steam/dont-starve-together", "steam/arma-reforger", "minecraft/velocity", "steam/core-keeper", "voice/teamspeak",
]
  .map((id) => library.find((e) => e.id === id))
  .filter((e) => e !== undefined);

// What the installer prints, step by step (cmd/raptor/bootstrap.go).
const install: [kind: string, text: string][] = [
  ["prompt", "$ curl -fsSL https://get.raptorpanel.net | sudo bash -s -- \\"],
  ["prompt cont", "-token rpt_join_…"],
  ["step", "==> Checking the box"],
  ["note", "Debian GNU/Linux 12 (bookworm), amd64, systemd, cgroups v2"],
  ["step", "==> Installing packages"],
  ["step", "==> Docker"],
  ["step", "==> Server data volume"],
  ["note", "an XFS volume with hard disk limits per server"],
  ["step", "==> Services"],
  ["step", "==> Linking to the Panel"],
  ["done", "Linked. Your node is online."],
];

// The tour: each part of the app, with its own screenshot.
const tour = [
  {
    id: "console",
    shot: "console",
    title: "Know how every server is doing, at a glance.",
    text: "Each server opens on its live console and what it's using: CPU, memory, disk, network, and who's online. When something's wrong, Needs attention says what, worst first, and common console errors come with the fix.",
    points: ["Crash detection and restarts, on by default", "Share a log on mclo.gs in one click, IPs hidden", "Alerts to Discord, Slack, Telegram, email, and more"],
    alt: "A Minecraft server's page in Raptor: running, its CPU, memory, disk, and network, and its live console",
  },
  {
    id: "files",
    shot: "files",
    title: "A real file manager, not an FTP client.",
    text: "Browse, edit configs with syntax highlighting, and drop worlds and modpacks onto a folder to upload them. Paste a link and the machine downloads it itself, or bring a whole server over from another host.",
    points: ["A trash, so nothing's gone by accident", "SFTP straight to your machine for anything bigger", "Archives made and extracted on the machine"],
    alt: "Raptor's file manager showing a Minecraft server's folders and files, with a folder tree beside the list",
  },
  {
    id: "backups",
    shot: "backups",
    title: "Backups that happen, and restores that work.",
    text: "New servers back up every day without you setting anything up. Backups are incremental and encrypted on your machine, worlds are saved whole, and you can open one and restore a single file or the whole server.",
    points: ["On the machine, in your own S3, B2, or SFTP, or with us", "Schedules: warn players, wait, back up, restart", "A safety backup before a wipe or a full restore"],
    alt: "A server's backups in Raptor: each backup with when it was taken, where it is, and its size",
  },
  {
    id: "activity",
    shot: "activity",
    title: "Bring your team. See who did what.",
    text: "Invite friends or staff, and give each one exactly the permissions they need on each server, down to a moderator who can only manage players. Everything anyone does is recorded and searchable.",
    points: ["Per-server permissions: console, files, backups, players", "Search activity by person, date, IP, or kind", "Dangerous actions need the owner's passkey"],
    alt: "A server's activity in Raptor: who did what and when, with filters to search it",
  },
];

// Where add-ons come from, as the Add-ons tab names them.
const sources = ["Modrinth", "CurseForge", "Hangar", "Feed The Beast", "Technic", "uMod", "Factorio mod portal", "Steam Workshop"];

const claims: [string, string][] = [
  ["Your servers don't need us to keep running.", "Your machine runs your servers, schedules, backups, and crash restarts on its own. If Raptor goes offline, your games stay up."],
  ["Dangerous actions need your passkey.", "Deleting a server, restoring a backup, or changing what code runs is signed on your device and checked by your machine. Not even Raptor can do it without you."],
  ["Your files stay on your machine.", "Players connect straight to it, and backups are encrypted with its own key before they go anywhere."],
  ["Open source, all of it.", "Raptor is AGPL-3.0: read every line that runs on your machine."],
];

const latest = changelog.flatMap((r) => r.changes.map((c) => ({ ...c, date: r.date }))).slice(0, 4);
const docsOrSite = (link: string) => (link.startsWith("/library") ? link : `${docs}${link}`);
---
<Base
  home
  title="Raptor: game servers on your own machine, with no panel to run"
  description={`Link a Linux box you own or rent with one command, and run any of ${count} games and apps on it: Minecraft, Rust, Valheim, Palworld, and more. We run the panel; your machine runs the servers. $${price} a month per machine, first month free.`}
  path="/"
>
  <div class="hero">
    <div class="wrap hero-copy">
      <a class="offer" href="/pricing/">
        <span class="offer-tag">First month free</span>
        <span>Then ${price} a month per machine, every server included</span>
      </a>
      <h1>Your machine. <span class="accent">Every game.</span></h1>
      <p class="lead">
        Link a Linux box you own or rent with one command, and run any of {floor}+ games and apps on it,
        from Minecraft to Valheim. We run the panel. Your machine runs the servers, and keeps running them
        even when we don't.
      </p>
      <div class="actions">
        <a class="button primary large" href={start} data-out>Start your free month</a>
        <a class="button large" href={demo} data-out>Try the demo</a>
        <a class="button primary large" href={app} data-in>Go to your dashboard</a>
        <a class="button large" href="/library/">Browse the games</a>
      </div>
      <p class="fine" data-out>Free for 30 days, then ${price} a month. Cancel anytime from the app.</p>
    </div>
    <div class="wrap hero-shot">
      <Screen shot="server" alt="A Minecraft server running in Raptor: its live console, CPU, memory, disk, network, and players" eager />
    </div>
  </div>

  <section aria-labelledby="library" class="home-lib">
    <div class="wrap">
      <div class="split-head">
        <h2 id="library">{floor}+ games and apps, tested and ready.</h2>
        <p class="intro">
          Every one is made by Raptor, tested on a real machine, and updated when the game is. Pick one and
          your machine installs it and starts it. Anything else with a Pterodactyl egg runs too.
        </p>
      </div>
      <ul class="wall" aria-label="Some of the games in the library">
        {wall.map((e) => (
          <li>
            <a href={href(e)}>
              <GameIcon icon={e.icon} size={56} />
              <span>{e.name.replace(/^Minecraft: /, "")}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="wall-foot">
        <form class="lib-search compact" role="search" action="/library/">
          <label class="sr-only" for="home-q">Find a game or app</label>
          <input id="home-q" name="q" type="search" placeholder="Is my game there?" autocomplete="off" spellcheck="false" />
          <button class="button" type="submit">Search</button>
        </form>
        <p class="cat-line">
          {categories.map((c) => (
            <a href={`/library/#${c.id}`}><span class="num">{byCategory(c.id).length}</span> {c.name.toLowerCase()}</a>
          ))}
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="how" class="how">
    <div class="wrap how-grid">
      <div>
        <h2 id="how">From a bare machine to a server your friends can join, in minutes.</h2>
        <ol class="steps">
          <li>
            <h3>Connect a node</h3>
            <p>Sign up, choose Connect node, and copy one command, with a token that works once.</p>
          </li>
          <li>
            <h3>Paste it on your machine</h3>
            <p>It installs Docker and Raptor, sets up disk limits, and links the machine. No ports to open for Raptor: it connects out. Debian 12 or 13, or Ubuntu 24.04, on x86 or ARM.</p>
          </li>
          <li>
            <h3>Pick a game</h3>
            <p>Raptor installs it and starts it. Players connect straight to your machine, at an address it comes with.</p>
          </li>
        </ol>
      </div>
      <figure class="terminal" aria-label="Linking a node: the installer checks the machine, installs Docker and Raptor, and links it">
        <div class="terminal-bar" aria-hidden="true">
          <span>root@your-box</span>
          <span class="live">[ Connected ]</span>
        </div>
        <pre aria-hidden="true">{
          install.map(([kind, text], i) => (
            <span class={`line ${kind}`} style={`--i: ${i}`}>{text}</span>
          ))
        }</pre>
      </figure>
    </div>
  </section>

  <section aria-labelledby="tour" class="tour">
    <div class="wrap">
      <h2 id="tour">Everything a server needs, in one place.</h2>
      <p class="intro">Real screens from the app, running real servers.</p>
      {tour.map((t, i) => (
        <article class="feature" aria-labelledby={`f-${t.id}`}>
          <div class="feature-copy">
            <h3 id={`f-${t.id}`}><span class="feature-n">0{i + 1}</span>{t.title}</h3>
            <div>
              <p>{t.text}</p>
              <ul>
                {t.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          </div>
          <Screen shot={t.shot} alt={t.alt} />
        </article>
      ))}
      <p class="more-row"><a class="button large" href="/features/">Every feature</a></p>
    </div>
  </section>

  <section aria-labelledby="addons" class="addons-band">
    <div class="wrap addons-grid">
      <div>
        <h2 id="addons">Plugins, mods, and modpacks, from where your players get them.</h2>
        <p class="intro">
          Search, install, and update add-ons from the server's Add-ons tab. Dependencies come along,
          client-only mods stay out, and one button updates everything that's behind. What Pterodactyl
          owners buy as add-ons is part of Raptor.
        </p>
        <a class="more-link" href="/features/#addons">How add-ons work</a>
      </div>
      <ul class="sources" aria-label="Where add-ons come from">
        {sources.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section aria-labelledby="new" class="new-band">
    <div class="wrap">
      <div class="split-head">
        <h2 id="new">New this week.</h2>
        <p class="intro">Raptor ships every week. <a href="/changelog/">Everything that's new</a>, newest first.</p>
      </div>
      <ul class="news">
        {latest.map((c) => (
          <li>
            <time datetime={c.date}>{longDate(c.date)}</time>
            <h3>{c.link ? <a href={docsOrSite(c.link)}>{c.title}</a> : c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="yours">
    <div class="wrap">
      <h2 id="yours">Your machine stays yours.</h2>
      <dl class="claims">
        {claims.map(([term, reason]) => (
          <div>
            <dt>{term}</dt>
            <dd>{reason}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section aria-labelledby="switch" class="switch-band">
    <div class="wrap switch-grid">
      <div>
        <h2 id="switch">Pterodactyl had <span class="accent">a good run.</span></h2>
        <p class="intro">
          Raptor does everything you run it for, with the add-ons you'd buy for it built in, and no panel to
          host or patch. It runs beside Pterodactyl on the same machine, and moves your servers over one at a
          time, files and all.
        </p>
        <div class="actions left">
          <a class="button large" href="/vs/pterodactyl/">Raptor vs Pterodactyl</a>
          <a class="button large" href="/compare/">Every panel, compared</a>
        </div>
      </div>
      <pre class="one-line"><code>raptor import pterodactyl</code></pre>
    </div>
  </section>

  <section aria-labelledby="pricing" class="pricing-section">
    <div class="wrap pricing">
      <div>
        <h2 id="pricing">One price. Every feature. Your first month free.</h2>
        <p class="intro">
          A game host bills every server by its memory. Raptor bills the machine: unlimited servers, people,
          schedules, and backups, and no limits on RAM, CPU, or players, because it's your hardware.
        </p>
        <a class="more-link" href="/pricing/">Pricing in full</a>
      </div>
      <div class="price">
        <p class="price-first"><span class="figure">$0</span> for your first month</p>
        <p class="price-then">then <strong>${price}</strong> a month for each machine you link</p>
        <ul>
          <li>Every feature, on every machine</li>
          <li>10 GB of Raptor Backup Storage per machine</li>
          <li>Read-only if you stop paying: your servers keep running</li>
        </ul>
        <a class="button primary large block" href={start}>Start your free month</a>
        <p class="fine">A card is needed to start. Nothing is charged for 30 days.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="faq">
    <div class="wrap faq">
      <div>
        <h2 id="faq">Questions people ask first.</h2>
        <p class="fine">
          More in <a href={docs}>the docs</a>, or ask on <a href={discord}>Discord</a>.
        </p>
      </div>
      <div class="answers">
        {faq.map(([q, a], i) => (
          <details open={i === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <aside class="closing" aria-labelledby="closing" slot="after">
    <div class="wrap">
      <p class="chip">[ Early access ]</p>
      <h2 id="closing">Your first month is on us.</h2>
      <p class="intro">
        Link a machine, start a server, and see if it's for you. Raptor is young and getting better every
        week; tell us what you need on Discord.
      </p>
      <div class="actions">
        <a class="button primary large" href={start}>Start your free month</a>
        <a class="button large" href={discord}>Join the Discord</a>
      </div>
    </div>
  </aside>
</Base>
