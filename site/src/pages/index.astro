---
import { readdirSync } from "node:fs";
import { join } from "node:path";
import Logo from "../components/Logo.astro";
import Screen from "../components/Screen.astro";
import "../styles/site.css";

const app = "https://app.raptorpanel.net";
const start = `${app}/signin`;
const docs = "https://docs.raptorpanel.net";
const discord = "https://discord.gg/HyUa3sRpeN";
const source = "https://github.com/xena-studios/raptor";
const title = "Raptor: Pterodactyl had a good run. No panel to host. First month free.";
const description =
  "Raptor does everything you run Pterodactyl for, and has the add-ons you'd buy for it built in, with no panel to host or patch. Link a Linux box and run as many game servers as it can handle, for $12 a month per machine. The first month is free.";

// What the installer prints, step by step (cmd/raptor/bootstrap.go).
const install: [kind: string, text: string][] = [
  ["prompt", "$ curl -fsSL https://get.raptorpanel.net | sudo bash -s -- \\"],
  ["prompt cont", "-token rpt_join_…"],
  ["step", "==> Checking the box"],
  ["note", "Debian GNU/Linux 12 (bookworm), amd64, systemd, cgroups v2"],
  ["step", "==> Installing packages"],
  ["step", "==> Docker"],
  ["step", "==> Server data volume"],
  ["note", "an XFS volume with hard disk limits per server"],
  ["step", "==> Services"],
  ["step", "==> Linking to the Panel"],
  ["done", "Linked. Your node is online."],
];

// What each side asks of you before the first server: Pterodactyl's
// panel is yours to run (its install guide), Raptor's is ours.
const chores: [string, string][] = [
  ["A machine for the panel", "A VPS, or a share of your game box's memory"],
  ["A domain, with DNS", "For the panel, and for every node"],
  ["nginx, PHP, and Composer", "The panel is a PHP app you deploy"],
  ["MariaDB and Redis", "Its database and cache, which you back up"],
  ["A queue worker and a cron job", "Or schedules quietly stop running"],
  ["TLS certificates", "For the panel, and again for every node"],
  ["Ports 8080 and 2022 open", "On every node, so the panel can reach it"],
  ["Updates, by hand", "Back up, pull, migrate, then re-apply your add-ons"],
];

// Head to head, row by row. docs-site's Raptor vs Pterodactyl page has
// the long version; keep the two in step.
const versus: { row: string; ptero: string; raptor: string }[] = [
  { row: "The panel", ptero: "Yours to host, patch, and back up", raptor: "Ours to run, at app.raptorpanel.net" },
  { row: "Linking a node", ptero: "A config file, a certificate, and two open ports", raptor: "One command. It connects out, so no ports" },
  { row: "If the panel goes down", ptero: "Nothing can be managed, and schedules stop", raptor: "Servers, schedules, and backups carry on" },
  { row: "Plugins, mods, the Workshop", ptero: "Paid add-ons, if one exists", raptor: "Built in" },
  { row: "Backups", ptero: "A full archive every time", raptor: "Incremental, deduplicated, and encrypted" },
  { row: "Disk limits", ptero: "Checked by scanning, after the fact", raptor: "Enforced by the kernel, as files are written" },
  { row: "Deleting a server or a backup", ptero: "Anyone who gets into the panel", raptor: "Only with your passkey, checked by your machine" },
  { row: "Players can't connect", ptero: "You work out why", raptor: "A connection test says what to fix" },
  { row: "When something breaks", ptero: "Volunteers on forums and Discord", raptor: "Our team, in a private ticket, and on your machine if you approve it" },
];

// What Pterodactyl costs once it does what Raptor does: a current add-on
// for each, from BuiltByBit, sourceXchange, or Blueprint (October 2026),
// one panel licence each. The listings are linked from the docs page
// (start/raptor-vs-pterodactyl); change both together.
const addons: [feature: string, addon: string, price: number][] = [
  ["Plugin installer", "Minecraft Plugin Installer", 17.5],
  ["Mod installer", "Modpack & Mods Installer", 5.99],
  ["Change a server's type", "Egg Changer", 6.49],
  ["Import from another host", "Server Importer", 7.99],
  ["Browse and edit databases", "Automatic phpMyAdmin", 16.99],
  ["Databases in backups", "MySQL Backup Manager", 14.49],
  ["Alerts on Discord", "Discord Notifications", 5.0],
];
const running: [what: string, detail: string, price: number][] = [
  ["A small VPS for the panel", "$6 a month", 72],
  ["A domain for it", "About $12 a year", 12],
];
// The cheapest install we found for hire (a BuiltByBit listing, $20 for
// the panel and one node; Fiverr gigs run up to $50). Nobody lists a
// monthly price for keeping it patched, so that's our estimate, $20 to
// $35 a month, counted at the low end and labelled as an estimate.
const hired: [what: string, detail: string, price: number][] = [
  ["A sysadmin to install it", "Panel, one node, and certificates", 20],
  ["A sysadmin to keep it patched", "Our estimate: $20 to $35 a month", 240],
];
const sum = (rows: [string, string, number][]) => rows.reduce((t, [, , p]) => t + p, 0);
const pteroSelf = sum(addons) + sum(running);
const pteroHired = pteroSelf + sum(hired);
const raptorYear = 11 * 12;
const usd = (n: number) => `$${n.toFixed(2)}`;

// What Pterodactyl has no answer for, with or without add-ons.
const only: { title: string; points: string[] }[] = [
  {
    title: "Backups you can trust",
    points: [
      "Incremental and deduplicated, not a full archive each time",
      "Encrypted on your machine before they go anywhere",
      "Open one and restore a single file",
      "A safety backup before every wipe or full restore",
      "Offsite in Raptor Backup Storage, with nothing to set up",
    ],
  },
  {
    title: "Tools on the machine",
    points: [
      "The raptor command and a terminal UI: status, power, console, logs, restores",
      "raptor doctor finds what's wrong and says how to fix it",
      "Wings updates itself, and rolls back if an update fails",
      "Disk limits the kernel enforces, with usage that's never stale",
    ],
  },
  {
    title: "Safety you can see",
    points: [
      "Deleting, restoring, and changing what runs needs your passkey",
      "A trash in the file manager, so a deleted file isn't gone",
      "Support only gets in when you approve it, for as long as you say",
      "Servers keep running, and schedules keep firing, when the panel is down",
    ],
  },
  {
    title: "More than game servers",
    points: [
      "MySQL, MariaDB, PostgreSQL, Redis, and MongoDB, with a browser for each",
      "Change a database's version, and reach it from outside, safely",
      "Private networks between servers, with rules between them",
      "Alerts to email, Discord, Slack, Telegram, ntfy, or a webhook",
      "A connection test that tells you why players can't join",
    ],
  },
];

// The tour: each part of the app, with its own screenshot.
const tour = [
  {
    id: "console",
    shot: "console",
    title: "Know how every server is doing, at a glance.",
    text: "Each server opens on its live console and what it's using: CPU, memory, disk, network, and players. Type commands, restart it, or pop the console out into its own window.",
    points: ["Crash detection and restarts, on by default", "Resource history for the last hour, day, or week", "Alerts when a server goes down, to Discord, Slack, email, and more"],
    alt: "A Minecraft server's page in Raptor: running, its CPU, memory, disk, and network, and its live console",
  },
  {
    id: "files",
    shot: "files",
    title: "A real file manager, not an FTP client.",
    text: "Browse, edit configs with syntax highlighting, and upload worlds and modpacks up to 1 GB each. Paste a link and the machine downloads it itself; bring a whole server over from another host.",
    points: ["A trash, so nothing's gone by accident", "SFTP straight to your machine for anything bigger", "Archives made and extracted on the machine"],
    alt: "Raptor's file manager showing a Minecraft server's folders and files, with a folder tree beside the list",
  },
  {
    id: "backups",
    shot: "backups",
    title: "Backups that happen, and restores that work.",
    text: "New servers back up every day without you setting anything up. Backups are incremental and encrypted on your machine, and you can open one and restore a single file or the whole server.",
    points: ["Keep them on the machine, in your own S3, B2, or SFTP, or with us", "Schedules: warn players, wait, back up, restart", "A safety backup before a wipe or a full restore"],
    alt: "A server's backups in Raptor: each backup with when it was taken, where it is, and its size",
  },
  {
    id: "activity",
    shot: "activity",
    title: "Bring your team. See who did what.",
    text: "Invite friends or staff as owners, admins, or members, and give each one exactly the permissions they need on each server. Everything anyone does is recorded and searchable.",
    points: ["Per-server permissions: console, files, backups, power", "Search activity by person, date, IP, or kind", "Dangerous actions need the owner's passkey"],
    alt: "A server's activity in Raptor: who did what and when, with filters to search it",
  },
];

const claims: [string, string][] = [
  ["Your servers don't need us to keep running.", "Your machine runs your servers, schedules, backups, and crash restarts on its own. If Raptor goes offline, your games stay up."],
  ["Dangerous actions need your passkey.", "Deleting a server, restoring a backup, or changing what code runs is signed on your device and checked by your machine. Not even Raptor can do it without you."],
  ["Your files stay on your machine.", "Players connect straight to it, and backups are encrypted with its own key before they go anywhere."],
  ["Open source, all of it.", "Raptor is AGPL-3.0: read every line that runs on your machine."],
];

// The catalog's eggs (eggs/<category>/<egg>), counted at build time so the
// number stays true. The build runs in site/.
const eggs = join(process.cwd(), "..", "eggs");
const catalog = readdirSync(eggs, { withFileTypes: true })
  .filter((d) => d.isDirectory())
  .flatMap((d) => readdirSync(join(eggs, d.name), { withFileTypes: true }))
  .filter((d) => d.isDirectory()).length;

const games: [string, string][] = [
  ["Minecraft", "Paper, Purpur, Fabric, Forge, NeoForge, Quilt, Vanilla, Bedrock"],
  ["Proxies", "Velocity, BungeeCord"],
  ["Steam", "Rust, Valheim, Palworld, ARK, CS2, Satisfactory, and more"],
  ["Standalone", "Terraria, Factorio, Vintage Story, OpenTTD, and more"],
  ["Bots and apps", "Node.js, Python, Bun"],
  ["Voice", "TeamSpeak, Mumble"],
];

const faq: [string, string][] = [
  ["Is the first month really free?", "Yes. Link your first machine and Raptor costs nothing for a month. A card is needed to start; you're charged $12 when the month is up, unless you cancel first, in the app's billing settings."],
  ["What do I need?", "A Linux machine you can run commands on as root: a dedicated server, a VPS, or a box at home, with Debian 12 or 13 or Ubuntu 24.04, on x86 or ARM. Raptor installs Docker and everything else."],
  ["Do I have to open ports?", "Not for Raptor: your machine connects out to it. Players need the game's own port open, and the connection test tells you if they can't reach it, with steps for your provider's firewall."],
  ["What happens if Raptor goes down?", "Nothing your players notice. Servers keep running, schedules keep firing, and backups keep happening on the machine, and the raptor command there still starts, stops, and shows logs."],
  ["Pterodactyl is free. Why pay?", "Pterodactyl's code is free; running it isn't. You host and patch the panel, buy add-ons for what Raptor has built in, and lose control of your servers whenever the panel is down. If you enjoy running all that, Pterodactyl is a fine choice. If you'd rather just run games, that's what the $12 is for."],
  ["I'm on Pterodactyl. Can I move?", "Yes, without starting over. Raptor runs the same eggs, and raptor import pterodactyl moves your servers over on the same machine, files and all, while Pterodactyl's copies stay untouched until you remove them."],
  ["What if I stop paying?", "The panel goes read-only for that machine. Raptor never stops your servers over billing, and the raptor command on the machine keeps working."],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://raptorpanel.net/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1a1314" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f5f5" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://raptorpanel.net/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://raptorpanel.net/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Raptor: Pterodactyl had a good run. No panel to host, every add-on built in. First month free." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip button small" href="#main">Skip to content</a>
    <header class="wrap top">
      <a class="brand" href="/" aria-label="Raptor, home"><Logo /></a>
      <nav aria-label="Main">
        <a class="wide" href="#versus">Vs Pterodactyl</a>
        <a class="wide" href="#tour">Tour</a>
        <a class="wide" href="#pricing">Pricing</a>
        <a class="link-docs" href={docs}>Docs</a>
        <a class="wide" href={discord}>Discord</a>
        <a class="link-signin" href={app}>Sign in</a>
        <a class="button small primary" href={start}>Start free</a>
      </nav>
    </header>

    <main id="main">
      <div class="hero">
        <div class="wrap hero-copy">
          <a class="offer" href="#pricing">
            <span class="offer-tag">First month free</span>
            <span>Then $12 a month per machine, every server included</span>
          </a>
          <h1>Pterodactyl had <span class="accent">a good run.</span></h1>
          <p class="lead">
            Raptor does everything you run Pterodactyl for, with the add-ons you'd buy for it built
            in, and no panel to host, patch, or keep alive. Link a Linux box you own or rent, and run as many game
            servers as it can handle.
          </p>
          <div class="actions">
            <a class="button primary large" href={start}>Start your free month</a>
            <a class="button large" href="#versus">See the difference</a>
          </div>
          <p class="fine">Free for 30 days, then $12 a month. Cancel anytime from the app.</p>
        </div>
        <div class="wrap hero-shot">
          <Screen shot="server" alt="A Minecraft server running in Raptor: its live console, CPU, memory, disk, network, and players" eager />
        </div>
      </div>

      <section aria-labelledby="versus" class="why">
        <div class="wrap">
          <h2 id="versus">Pterodactyl makes you run the panel. Raptor is the panel.</h2>
          <p class="intro">
            Pterodactyl is free software, and the panel is yours to keep alive: a whole web stack
            you install, secure, and update, before your first server and long after it. With Raptor,
            your machine runs the games and we run everything else.
          </p>
          <div class="versus">
            <div class="side">
              <p class="side-head"><span>Pterodactyl</span><span class="side-count">{chores.length} things to run</span></p>
              <ol class="chores">
                {chores.map(([what, why]) => (
                  <li><span>{what}</span><span>{why}</span></li>
                ))}
              </ol>
            </div>
            <div class="side us">
              <p class="side-head"><span>Raptor</span><span class="side-count">1 command</span></p>
              <pre class="one-line"><code>curl -fsSL https://get.raptorpanel.net | sudo bash -s -- -token rpt_join_…</code></pre>
              <ul class="done-list">
                <li>No ports to open for it: your machine connects out</li>
                <li>A hostname for every node, that follows its IP</li>
                <li>Updates itself, and rolls back if an update fails</li>
                <li>The panel is ours to host, patch, and back up</li>
              </ul>
            </div>
          </div>
          <div class="table-scroll">
            <table class="compare">
              <thead>
                <tr>
                  <th scope="col"><span class="sr-only">What</span></th>
                  <th scope="col">Pterodactyl</th>
                  <th scope="col" class="us">Raptor</th>
                </tr>
              </thead>
              <tbody>
                {versus.map((v) => (
                  <tr>
                    <th scope="row">{v.row}</th>
                    <td data-label="Pterodactyl">{v.ptero}</td>
                    <td class="us" data-label="Raptor">{v.raptor}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section aria-labelledby="cost" class="cost">
        <div class="wrap">
          <h2 id="cost">Pterodactyl is free. Making it do what Raptor does isn't.</h2>
          <p class="intro">
            What Raptor has built in, Pterodactyl leaves to paid add-ons from different authors,
            and many have to be applied again after every panel update. Here's a first year with
            one machine, at what the add-ons sell for today.
          </p>
          <div class="receipts">
            <figure class="receipt" aria-labelledby="r-ptero">
              <figcaption id="r-ptero">Pterodactyl, year one</figcaption>
              <table>
                <caption class="sr-only">What a year of Pterodactyl with Raptor's features costs</caption>
                <tbody>
                  <tr class="group"><th scope="rowgroup" colspan="2">Add-ons, once</th></tr>
                  {addons.map(([feature, addon, price]) => (
                    <tr>
                      <th scope="row">{feature}<span>{addon}</span></th>
                      <td>{usd(price)}</td>
                    </tr>
                  ))}
                  <tr class="group"><th scope="rowgroup" colspan="2">Running the panel</th></tr>
                  {running.map(([what, detail, price]) => (
                    <tr>
                      <th scope="row">{what}<span>{detail}</span></th>
                      <td>{usd(price)}</td>
                    </tr>
                  ))}
                  <tr class="group"><th scope="rowgroup" colspan="2">Unless you're the sysadmin</th></tr>
                  {hired.map(([what, detail, price]) => (
                    <tr>
                      <th scope="row">{what}<span>{detail}</span></th>
                      <td>{usd(price)}</td>
                    </tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr class="subtotal">
                    <th scope="row">Doing it all yourself<span>Every install, update, and fix is yours</span></th>
                    <td>{usd(pteroSelf)}</td>
                  </tr>
                  <tr>
                    <th scope="row">Year one<span>With a sysadmin doing it for you</span></th>
                    <td>{usd(pteroHired)}</td>
                  </tr>
                </tfoot>
              </table>
            </figure>
            <figure class="receipt us" aria-labelledby="r-raptor">
              <figcaption id="r-raptor">Raptor, year one</figcaption>
              <table>
                <caption class="sr-only">What a year of Raptor costs</caption>
                <tbody>
                  <tr>
                    <th scope="row">Your first month<span>Free</span></th>
                    <td>{usd(0)}</td>
                  </tr>
                  <tr>
                    <th scope="row">The next 11 months<span>$12 a month</span></th>
                    <td>{usd(raptorYear)}</td>
                  </tr>
                  <tr>
                    <th scope="row">Every add-on Pterodactyl needed<span>Built in, updated with Raptor</span></th>
                    <td>{usd(0)}</td>
                  </tr>
                  <tr>
                    <th scope="row">A machine for the panel<span>We run it</span></th>
                    <td>{usd(0)}</td>
                  </tr>
                  <tr>
                    <th scope="row">A domain<span>Every node comes with a hostname</span></th>
                    <td>{usd(0)}</td>
                  </tr>
                  <tr>
                    <th scope="row">Help from our team<span>Moving over, and when your machine acts up</span></th>
                    <td>{usd(0)}</td>
                  </tr>
                </tbody>
                <tfoot>
                  <tr>
                    <th scope="row">Year one<span>And nothing to patch</span></th>
                    <td>{usd(raptorYear)}</td>
                  </tr>
                </tfoot>
              </table>
              <a class="button primary large block" href={start}>Start your free month</a>
            </figure>
          </div>
          <p class="fine footnote">
            Add-on prices are from current listings on BuiltByBit, sourceXchange, and Blueprint in
            October 2026, each licensed for one panel; some have cheaper look-alikes, some pricier.
            The install is the cheapest we found for hire; Fiverr gigs charge up to $50. Nobody
            lists a price for keeping it patched, so that line is our estimate, counted at $20 a month. You can run the panel on your game machine instead of a VPS,
            and give up some of its memory. <a href={`${docs}/start/raptor-vs-pterodactyl/`}>The full
            comparison, with sources</a>.
          </p>
        </div>
      </section>

      <section aria-labelledby="only" class="only-section">
        <div class="wrap">
          <h2 id="only">What no add-on gives Pterodactyl.</h2>
          <p class="intro">
            Some of Raptor isn't for sale anywhere else, because it's built into how Raptor works: on
            your machine, signed by you, and still running when we're not.
          </p>
          <div class="only">
            {only.map((o) => (
              <div>
                <h3>{o.title}</h3>
                <ul>
                  {o.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section aria-labelledby="move" class="move">
        <div class="wrap move-grid">
          <div>
            <h2 id="move">Leaving Pterodactyl? We'll help you move.</h2>
            <p class="intro">
              You don't start over, and you don't switch in one night. Raptor runs beside Pterodactyl
              on the same machine, so you move one server at a time and keep the way back open.
            </p>
            <ol class="steps">
              <li>
                <h3>Link the machine Pterodactyl's on</h3>
                <p>Raptor keeps its ports, networks, and containers apart from Pterodactyl's, so nothing there changes.</p>
              </li>
              <li>
                <h3>Run <code>raptor import pterodactyl</code></h3>
                <p>Each server comes over with its egg, settings, ports, and files. Pterodactyl's copy is suspended, never deleted.</p>
              </li>
              <li>
                <h3>Check it runs, then turn Pterodactyl off</h3>
                <p>Players join on the same ports. Remove the old copies when you're sure.</p>
              </li>
            </ol>
          </div>
          <div class="helpdesk">
            <h3>And a team behind you, not a forum.</h3>
            <p>
              Running servers on your own machine shouldn't mean being your own sysadmin. Open a
              ticket and the people who build Raptor help with the move and with the machine:
              installs, firewalls, ports, disks, and players who can't connect.
            </p>
            <ul>
              <li>A private ticket on Discord, not a public thread</li>
              <li><code>raptor doctor</code> sends us what's wrong, with secrets removed</li>
              <li>If we need to look, you approve it with your passkey, for as long as you choose</li>
              <li>Everything we do is in your activity log, and we never get a shell</li>
            </ul>
            <a class="button large" href={`${docs}/install/from-pterodactyl/`}>How moving works</a>
          </div>
        </div>
      </section>

      <section aria-labelledby="tour" class="tour">
        <div class="wrap">
          <h2 id="tour">Everything a server needs, in one place.</h2>
          <p class="intro">Real screens from the app, running real servers.</p>
          {tour.map((t, i) => (
            <article class="feature" aria-labelledby={`f-${t.id}`}>
              <div class="feature-copy">
                <h3 id={`f-${t.id}`}><span class="feature-n">0{i + 1}</span>{t.title}</h3>
                <div>
                  <p>{t.text}</p>
                  <ul>
                    {t.points.map((p) => <li>{p}</li>)}
                  </ul>
                </div>
              </div>
              <Screen shot={t.shot} alt={t.alt} />
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="how" class="how">
        <div class="wrap how-grid">
          <div>
            <h2 id="how">From a bare machine to a server your friends can join, in minutes.</h2>
            <ol class="steps">
              <li>
                <h3>Connect a node</h3>
                <p>Sign up, choose Connect node, and copy one command, with a token that works once.</p>
              </li>
              <li>
                <h3>Paste it on your machine</h3>
                <p>It installs Docker and Raptor, sets up disk limits, and links the machine. Debian 12 or 13, or Ubuntu 24.04, on x86 or ARM.</p>
              </li>
              <li>
                <h3>Pick a game</h3>
                <p>Raptor installs it and starts it. Players connect straight to your machine, at an address it comes with.</p>
              </li>
            </ol>
          </div>
          <figure class="terminal" aria-label="Linking a node: the installer checks the machine, installs Docker and Raptor, and links it">
            <div class="terminal-bar" aria-hidden="true">
              <span>root@your-box</span>
              <span class="live">[ Connected ]</span>
            </div>
            <pre aria-hidden="true">{
              install.map(([kind, text], i) => (
                <span class={`line ${kind}`} style={`--i: ${i}`}>{text}</span>
              ))
            }</pre>
          </figure>
        </div>
      </section>

      <section aria-labelledby="yours">
        <div class="wrap">
          <h2 id="yours">Your machine stays yours.</h2>
          <dl class="claims">
            {claims.map(([term, reason]) => (
              <div>
                <dt>{term}</dt>
                <dd>{reason}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section aria-labelledby="games">
        <div class="wrap games">
          <div>
            <h2 id="games">Runs what Pterodactyl runs.</h2>
            <p class="intro">
              Raptor reads Pterodactyl and Pelican eggs, so anything with one can run, and {catalog}
              are ready to pick. Already on Pterodactyl? <a href="#move">Your servers come with you</a>.
            </p>
          </div>
          <ul class="certified" aria-label="Supported games and apps">
            {games.map(([name, detail]) => (
              <li><span>{name}</span><span>{detail}</span></li>
            ))}
          </ul>
        </div>
      </section>

      <section aria-labelledby="pricing" class="pricing-section">
        <div class="wrap pricing">
          <div>
            <h2 id="pricing">One price. Every feature. Your first month free.</h2>
            <p class="intro">
              A game host bills every server by its memory. Raptor bills the machine: unlimited
              servers, people, schedules, and backups, and no limits on RAM, CPU, or players, because
              it's your hardware. Ten servers on one machine is still $12.
            </p>
          </div>
          <div class="price">
            <p class="price-first"><span class="figure">$0</span> for your first month</p>
            <p class="price-then">then <strong>$12</strong> a month for each machine you link</p>
            <ul>
              <li>Every feature, on every machine</li>
              <li>10 GB of Raptor Backup Storage per machine, then $12 per TB a month</li>
              <li>Read-only if you stop paying: your servers keep running</li>
              <li>Cancel anytime from the app; taxes handled by Polar, who bills for us</li>
            </ul>
            <a class="button primary large block" href={start}>Start your free month</a>
            <p class="fine">A card is needed to start. Nothing is charged for 30 days.</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="faq">
        <div class="wrap faq">
          <div>
            <h2 id="faq">Questions people ask first.</h2>
            <p class="fine">
              More in <a href={docs}>the docs</a>, or ask on <a href={discord}>Discord</a>.
            </p>
          </div>
          <div class="answers">
            {faq.map(([q, a], i) => (
              <details open={i === 0}>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <aside class="closing" aria-labelledby="closing">
      <div class="wrap">
        <p class="chip">[ Early access ]</p>
        <h2 id="closing">Your first month is on us.</h2>
        <p class="intro">
          Link a machine, start a server, and see if it's for you. Raptor is young and getting better
          every week; tell us what you need on Discord.
        </p>
        <div class="actions">
          <a class="button primary large" href={start}>Start your free month</a>
          <a class="button large" href={discord}>Join the Discord</a>
        </div>
      </div>
    </aside>

    <footer>
      <div class="wrap">
        <span>Raptor is open source under the AGPL-3.0. Pterodactyl is a trademark of its owners; Raptor isn't affiliated with it.</span>
        <nav aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={discord}>Discord</a>
          <a href={source}>Source</a>
          <a href="https://status.raptorpanel.net">Status</a>
          <a href={`${source}/blob/main/SECURITY.md`}>Security</a>
          <a href="mailto:abuse@raptorpanel.net" title="A raptornodes.net name used for phishing, malware, or spam">Report abuse</a>
          <a href={app}>Sign in</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
