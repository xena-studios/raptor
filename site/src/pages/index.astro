---
import { readdirSync } from "node:fs";
import { join } from "node:path";
import Logo from "../components/Logo.astro";
import "../styles/site.css";

const app = "https://app.raptorpanel.net";
const start = `${app}/signin`;
const docs = "https://docs.raptorpanel.net";
const discord = "https://discord.gg/HyUa3sRpeN";
const source = "https://github.com/xena-studios/raptor";
const title = "Raptor: game servers on your own machines";
const description =
  "Turn a Linux box you own or rent into a game server host you run from your browser. One command to set up, $12 a month per machine, first month free. Open source.";

// What the installer prints, step by step (cmd/raptor/bootstrap.go).
const install: [kind: string, text: string][] = [
  ["prompt", "$ curl -fsSL https://get.raptorpanel.net | sudo bash -s -- \\"],
  ["prompt cont", "-token rpt_join_…"],
  ["step", "==> Checking the box"],
  ["note", "Debian GNU/Linux 12 (bookworm), amd64, systemd, cgroups v2"],
  ["step", "==> Installing packages"],
  ["step", "==> Docker"],
  ["note", "merged live-restore, userland-proxy off, log rotation"],
  ["step", "==> The raptor user"],
  ["step", "==> Server data volume"],
  ["note", "image: an XFS image file on this disk, with hard limits"],
  ["step", "==> Services"],
  ["note", "raptor-wings and raptor-shutdown enabled and started"],
  ["step", "==> Linking to the Panel"],
  ["done", "Linked. Your node is online."],
];

const claims: [string, string][] = [
  [
    "Dangerous actions need your passkey.",
    "Deleting a server, restoring a backup, or changing what code runs is signed on your device and checked by your node. Not even Raptor can do them without you.",
  ],
  [
    "Your servers don't need us to keep running.",
    "The node runs your servers, schedules, backups, and crash restarts on its own. If Raptor goes offline, your games stay up.",
  ],
  [
    "Your files stay on your machine.",
    "Players connect straight to your node. Backups are encrypted with your node's own key and go where you choose: the node itself, S3-compatible storage, SFTP, and more.",
  ],
  [
    "Disk limits the kernel enforces.",
    "Each server gets a hard limit, so one that fills its disk can't take the others down with it.",
  ],
  [
    "Open source, all of it.",
    "Raptor is AGPL-3.0, and the app links to the exact commit it's running.",
  ],
];

// The catalog's eggs (eggs/<category>/<egg>), counted at build time so the
// number stays true.
// The build runs in site/.
const eggs = join(process.cwd(), "..", "eggs");
const catalog = readdirSync(eggs, { withFileTypes: true })
  .filter((d) => d.isDirectory())
  .flatMap((d) => readdirSync(join(eggs, d.name), { withFileTypes: true }))
  .filter((d) => d.isDirectory()).length;

// What's in the app, in the order an owner meets it.
const features: [string, string][] = [
  ["Console and stats", "A live console you can type into, players online, and CPU, memory, and disk over the last hour, day, or week."],
  ["Files", "A file manager with a code editor, uploads up to 1 GB, links downloaded straight onto the machine, imports from another host, and SFTP for the rest."],
  ["Backups", "On by default: incremental, deduplicated, and encrypted, kept on the machine, in your own S3, B2, or SFTP storage, or in ours."],
  ["Schedules", "Warn the players, wait, back up, restart: steps in order, in your time zone."],
  ["Alerts", "A server down or crashing, a machine offline, disk running low: to your inbox, email, Discord, Slack, ntfy, or a webhook."],
  ["Teams", "Orgs with owners, admins, and members, permissions per server, and a searchable record of everything anyone did."],
];

// A server's console, as the app shows it.
const console_: [kind: string, text: string][] = [
  ["dim", "[12:04:31 INFO]: Done (6.412s)! For help, type \"help\""],
  ["", "[12:06:02 INFO]: Steve joined the game"],
  ["", "[12:06:40 INFO]: <Steve> anyone up for the nether?"],
  ["", "[12:07:15 INFO]: Alex joined the game"],
  ["dim", "[12:10:00 INFO]: [Raptor] Backing up in 5 minutes"],
  ["prompt", "> say Back in a minute after the backup"],
];

// Resources over the last hour, for the sparkline: CPU %, every 5 minutes.
const cpu = [22, 31, 28, 35, 41, 38, 52, 47, 44, 39, 36, 38];
const spark = cpu.map((v, i) => `${(i / (cpu.length - 1)) * 100},${40 - (v / 60) * 36}`).join(" ");

const faq: [string, string][] = [
  [
    "What do I need?",
    "A Linux machine you can run commands on as root: a dedicated server, a VPS, or a box at home, with Debian 12 or 13 or Ubuntu 24.04, on x86 or ARM. Raptor installs Docker and everything else.",
  ],
  [
    "Do I have to open ports?",
    "Not for Raptor: the machine connects out to it. Players need the game's own port open, and the connection test tells you if they can't reach it, with steps for your provider's firewall.",
  ],
  [
    "What happens if Raptor goes down?",
    "Nothing your players notice. Servers keep running, schedules keep firing, and backups keep happening on the machine. You can still start, stop, and read logs from the machine itself with the raptor command.",
  ],
  [
    "How is this different from Pterodactyl?",
    "There's no panel to install, secure, or update, and no ports, certificates, or DNS to set up for it. Raptor reads Pterodactyl and Pelican eggs, and raptor import pterodactyl moves your servers over on the same machine.",
  ],
  [
    "What if I stop paying?",
    "The panel goes read-only for that machine. Raptor never stops your servers over billing, and the raptor command on the machine keeps working.",
  ],
  [
    "Can Raptor touch my servers without me?",
    "Not the parts that matter. Deleting servers, restoring backups, and changing what code runs have to be signed by your passkey, and your machine checks the signature itself.",
  ],
];

const games: [string, string][] = [
  ["Minecraft", "Paper, Purpur, Fabric, Forge, NeoForge, Quilt, Vanilla, Bedrock"],
  ["Proxies", "Velocity, BungeeCord"],
  ["Steam", "Rust, Valheim, Palworld, ARK, CS2, Satisfactory, and more"],
  ["Standalone", "Terraria, Factorio, Vintage Story, OpenTTD, and more"],
  ["Bots and apps", "Node.js, Python, Bun"],
  ["Voice", "TeamSpeak, Mumble"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://raptorpanel.net/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1a1314" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f5f5" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://raptorpanel.net/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://raptorpanel.net/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Raptor: game servers on your own machines, run from one place." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip button small" href="#main">Skip to content</a>
    <header class="wrap top">
      <a class="brand" href="/" aria-label="Raptor, home"><Logo /></a>
      <nav aria-label="Main">
        <a class="wide" href="#pricing">Pricing</a>
        <a href={docs}>Docs</a>
        <a class="wide" href={discord}>Discord</a>
        <a class="wide" href={source}>GitHub</a>
        <a class="button small" href={app}>Sign in</a>
      </nav>
    </header>

    <main id="main">
      <div class="wrap hero">
        <div>
          <p class="chip">[ Early access ]</p>
          <h1>Game servers on your own machines, <span class="accent">run from one place.</span></h1>
          <p class="lead">
            Bring a Linux box you own or rent. Paste one command on it, then create servers and
            manage their consoles, files, backups, and schedules from your browser. There's no
            panel to install and nothing to keep updated.
          </p>
          <div class="actions">
            <a class="button primary" href={start}>Get started</a>
            <a class="button" href={`${docs}/install/first-node/`}>Read the guide</a>
          </div>
          <p class="fine">$12 a month per machine. The first month is free.</p>
        </div>

        <figure class="terminal" aria-label="Linking a node: the installer checks the machine, installs Docker and Raptor, and links it">
          <div class="terminal-bar" aria-hidden="true">
            <span>root@your-box</span>
            <span class="live">[ Connected ]</span>
          </div>
          <pre aria-hidden="true">{
            install.map(([kind, text], i) => (
              <span class={`line ${kind}`} style={`--i: ${i}`}>{text}</span>
            ))
          }</pre>
        </figure>
      </div>

      <section aria-labelledby="how">
        <div class="wrap">
          <h2 id="how">From a bare machine to a server your friends can join.</h2>
          <ol class="steps">
            <li>
              <h3>Connect a node</h3>
              <p>In the app, choose Connect node. You get one command, with a token that works once, for an hour.</p>
            </li>
            <li>
              <h3>Paste it on your machine</h3>
              <p>It installs Docker and Raptor, sets up disk limits, and links the machine. Debian 12 or 13, or Ubuntu 24.04, on x86 or ARM.</p>
            </li>
            <li>
              <h3>Create a server</h3>
              <p>Pick a game and name it. Raptor installs and starts it, and players connect straight to your machine.</p>
            </li>
          </ol>
        </div>
      </section>

      <section aria-labelledby="app">
        <div class="wrap product">
          <div>
            <h2 id="app">Everything a server needs, in your browser.</h2>
            <p class="intro">
              One place for every server on every machine you link, from a phone or a laptop.
            </p>
          </div>

          <figure class="window" aria-label="A server's overview in the app: it's running, two players are online, its CPU over the last hour, and its console">
            <div class="window-bar" aria-hidden="true">
              <span class="window-title">Survival</span>
              <span class="window-sub">Paper 1.21.4 · home-box</span>
              <span class="state">[ Running ]</span>
            </div>
            <div class="window-body" aria-hidden="true">
              <div class="readouts">
                <div><span class="label">Players</span><span class="value">2<span class="of"> / 20</span></span></div>
                <div><span class="label">Memory</span><span class="value">3.1<span class="of"> / 6 GB</span></span></div>
                <div><span class="label">Disk</span><span class="value">8.4<span class="of"> / 40 GB</span></span></div>
              </div>
              <div class="chart">
                <span class="label">CPU, last hour</span>
                <svg viewBox="0 0 100 40" preserveAspectRatio="none">
                  <polyline points={spark} fill="none" vector-effect="non-scaling-stroke" />
                </svg>
              </div>
              <div class="address">
                <span class="label">Connect</span>
                <code>1cdd002cd9a3.raptornodes.net:25565</code>
              </div>
              <pre class="console">{
                console_.map(([kind, text]) => <span class={`line ${kind}`}>{text}</span>)
              }</pre>
            </div>
          </figure>
          <dl class="features">
              {features.map(([term, detail]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{detail}</dd>
                </div>
              ))}
            </dl>
        </div>
      </section>

      <section aria-labelledby="yours">
        <div class="wrap">
          <h2 id="yours">Your machine stays yours.</h2>
          <p class="intro">
            Raptor manages your servers without owning them. The parts that could hurt you are the
            parts that need you.
          </p>
          <dl class="claims">
            {claims.map(([term, reason]) => (
              <div>
                <dt>{term}</dt>
                <dd>{reason}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section aria-labelledby="games">
        <div class="wrap games">
          <div>
            <h2 id="games">Runs what Pterodactyl runs.</h2>
            <p class="intro">
              Raptor reads Pterodactyl and Pelican eggs, so anything with one can run, and its
              catalog has {catalog} ready to pick. Already on Pterodactyl? <code>raptor import pterodactyl</code>{" "}
              moves your servers over on the same machine.
            </p>
          </div>
          <ul class="certified" aria-label="Supported games and apps">
            {games.map(([name, detail]) => (
              <li><span>{name}</span><span>{detail}</span></li>
            ))}
          </ul>
        </div>
      </section>
      <section aria-labelledby="pricing">
        <div class="wrap pricing">
          <div>
            <h2 id="pricing">One price per machine. Everything included.</h2>
            <p class="intro">
              Unlimited servers, people, schedules, and backups on every machine. No limits on RAM,
              CPU, or players: it's your hardware.
            </p>
          </div>
          <div class="price">
            <p class="amount"><span class="figure">$12</span> a month per machine</p>
            <ul>
              <li>The first machine is free for a month. A card is needed to start.</li>
              <li>10 GB of Raptor Backup Storage with every machine, shared across the org; more is $12 per TB a month, billed by the GB.</li>
              <li>If you stop paying, the panel goes read-only. Your servers keep running.</li>
              <li>Taxes and VAT are handled by Polar, who bills for us.</li>
            </ul>
            <a class="button primary" href={start}>Start the free month</a>
          </div>
        </div>
      </section>

      <section aria-labelledby="faq">
        <div class="wrap faq">
          <h2 id="faq">Questions people ask first.</h2>
          <div class="answers">
            {faq.map(([q, a]) => (
              <details>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
            <p class="fine">
              More in <a href={docs}>the docs</a>, or ask on <a href={discord}>Discord</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <aside class="status" aria-labelledby="status">
      <div class="wrap">
        <div>
          <h2 id="status">Raptor is in early access.</h2>
          <p class="intro">
            It runs in production and billing is live, but it's young: expect rough edges, and tell
            us about them. Bugs, requests, and help are on Discord; every line is on GitHub.
          </p>
        </div>
        <div class="actions">
          <a class="button" href={discord}>Join the Discord</a>
          <a class="button primary" href={start}>Get started</a>
        </div>
      </div>
    </aside>

    <footer>
      <div class="wrap">
        <span>Raptor is open source under the AGPL-3.0.</span>
        <nav aria-label="Footer">
          <a href={docs}>Docs</a>
          <a href={discord}>Discord</a>
          <a href={source}>Source</a>
          <a href="https://status.raptorpanel.net">Status</a>
          <a href={`${source}/blob/main/SECURITY.md`}>Security</a>
          <a href="mailto:abuse@raptorpanel.net" title="A raptornodes.net name used for phishing, malware, or spam">Report abuse</a>
          <a href={app}>Sign in</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
