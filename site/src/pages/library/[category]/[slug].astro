---
// One page per library entry, at its egg ID (/library/steam/valheim/):
// what it is, what Raptor does for it, the settings it has, and how to
// start one. Everything comes from the egg and its raptor.yaml.
import GameIcon from "../../../components/GameIcon.astro";
import Base from "../../../layouts/Base.astro";
import { docs, price, start } from "../../../data/links";
import { byCategory, categoryName, href, library, list, type Entry } from "../../../lib/library";

export function getStaticPaths() {
  return library.map((e) => ({ params: { category: e.category, slug: e.slug }, props: { e } }));
}

const { e } = Astro.props as { e: Entry };
const isApp = e.category === "software" || e.category === "generic";
const cat = categoryName(e.category);
const first = e.description.split(/(?<=\.)\s/)[0] ?? e.description;
const title = isApp ? `Self-host ${e.name}` : `${e.name} server hosting on your own machine`;
const description = `${isApp ? `Run ${e.name}` : `Run a ${e.name} server`} on your own Linux machine with Raptor, for $${price} a month per machine. ${first}`;

// What Raptor does for this one, from its raptor.yaml.
const facts: [term: string, detail: string][] = [];
if (e.addons.length) facts.push(["Add-ons", `Search and install ${list(e.addons)}, with their dependencies, and update them all at once.`]);
if (e.modpack) facts.push(["Modpacks", `Pick a modpack from ${e.modpack} by name, and Raptor installs it.`]);
if (e.workshop) facts.push(["Steam Workshop", "Paste a Workshop link or collection, and the game downloads the items itself."]);
if (e.players) facts.push(["Players", "Who's online and how many, live, on the server's overview."]);
facts.push([
  "Backups",
  e.safeBackups
    ? "Incremental and encrypted on your machine, with saving paused around each one so the world is backed up whole."
    : "Incremental and encrypted on your machine, every day by default. Restore one file or the whole server.",
]);
if (e.web) facts.push(["Web page", `A button on the server opens ${e.name}'s own page.`]);
facts.push(["Runs on", `${e.arch.map((a) => (a === "amd64" ? "x86" : "ARM")).join(" and ")} machines, on ${e.images.length > 1 ? `${e.images.length} runtimes you can pick from: ${list(e.images)}` : `Raptor's ${e.images[0] ?? "own"} image`}.`]);

const related = byCategory(e.category).filter((x) => x.id !== e.id);
// The same handful of neighbours every build: the ones beside it in the list.
const at = Math.max(0, byCategory(e.category).findIndex((x) => x.id === e.id));
const near = [...related.slice(at, at + 6), ...related.slice(0, Math.max(0, 6 - related.slice(at).length))].slice(0, 6);
const vars = e.variables.filter((v) => v.description);
// A default worth showing: not empty, and not a bare on/off switch.
const shown = (d: string) => d !== "" && !/^(0|1|true|false)$/.test(d);
const credits = e.credits.map((c) => (/[.)]$/.test(c) ? c : `${c}.`)).join(" ");
---
<Base title={title} description={description} path={href(e)}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Games and apps", item: "https://raptorpanel.net/library/" },
      { "@type": "ListItem", position: 2, name: cat, item: `https://raptorpanel.net/library/#${e.category}` },
      { "@type": "ListItem", position: 3, name: e.name },
    ],
  })} />

  <div class="wrap game-head">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/library/">Games and apps</a><span aria-hidden="true">/</span><a href={`/library/#${e.category}`}>{cat}</a>
    </nav>
    <div class="game-title">
      <GameIcon icon={e.icon} size={96} eager />
      <div>
        <h1>{e.name}</h1>
        <p class="game-sub">{isApp ? "on your own machine" : "on your own machine, for you and your players"}</p>
      </div>
    </div>
    <p class="lead">{e.description}</p>
    <div class="actions">
      <a class="button primary large" href={start}>Start your free month</a>
      <a class="button large" href={`${docs}/install/first-server/`}>How a first server works</a>
    </div>
    <p class="fine">${price} a month per machine, with as many servers as it can run. Already on Raptor? It's in your team's Eggs, as <code>{e.id}</code>.</p>
  </div>

  <section class="wrap game-body" aria-label={`${e.name} on Raptor`}>
    <div class="game-main">
      <h2>What Raptor does for it</h2>
      <dl class="facts">
        {facts.map(([t, d]) => (
          <div><dt>{t}</dt><dd>{d}</dd></div>
        ))}
        <div><dt>Every server</dt><dd>A live console, a file manager with a trash, schedules, crash restarts, alerts, and SFTP. It keeps running if Raptor goes down.</dd></div>
      </dl>

      {vars.length > 0 && (
        <>
          <h2>Settings you can change</h2>
          <p class="intro-sm">From the server's Startup tab, without touching a file.</p>
          <dl class="vars">
            {vars.map((v) => (
              <div>
                <dt>{v.name}</dt>
                <dd>{v.description}{shown(v.default) && <span class="var-default">Default <code>{v.default}</code></span>}</dd>
              </div>
            ))}
          </dl>
        </>
      )}
    </div>

    <aside class="game-side" aria-label="Getting started">
      <h2>From a bare machine</h2>
      <ol class="steps compact">
        <li><h3>Link your machine</h3><p>One command on any Debian or Ubuntu box, at home or rented.</p></li>
        <li><h3>Pick {e.name}</h3><p>Raptor installs it and starts it, on images it keeps updated.</p></li>
        <li><h3>{isApp ? "Open it" : "Invite your players"}</h3><p>{isApp ? "At an address your machine comes with, or your own domain." : "They connect straight to your machine, at the address it comes with."}</p></li>
      </ol>
      <p class="credits">
        Made by Raptor and MIT-licensed. {credits}{" "}
        <a href={e.source}>The egg's source</a>.
      </p>
    </aside>
  </section>

  {near.length > 0 && (
    <section class="wrap game-more" aria-labelledby="more">
      <h2 id="more">More {cat.toLowerCase()}</h2>
      <ul class="lib-grid">
        {near.map((x) => (
          <li>
            <a href={href(x)}>
              <GameIcon icon={x.icon} size={40} />
              <span class="lib-name">{x.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <p><a class="more-link" href={`/library/#${e.category}`}>All {related.length + 1} {cat.toLowerCase()}</a></p>
    </section>
  )}
</Base>
