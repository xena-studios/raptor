# Response headers for docs.raptorpanel.net (Cloudflare Workers reads this
# file from the build output; docs/DEPLOY.md#static-sites). The build fills
# in the inline-script placeholder below with the hashes of Starlight's few
# inline scripts (scripts/headers.mjs), so nothing else inline can run.
# Search (Pagefind) runs as WebAssembly, hence 'wasm-unsafe-eval'. No
# passkeys live on this origin (docs/DECISIONS.md #82), and it loads nothing
# from anywhere else.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' __INLINE_SCRIPTS__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), publickey-credentials-get=(), publickey-credentials-create=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build files never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
