---
// Starlight's header with raptorpanel.net's main links before the icons, so
// the docs sit in the same family as the site (site/src/layouts/Base.astro).
// The markup and grid are Starlight's own (Header.astro, 0.43); only the
// site links are new. Narrow screens get the same links in the footer.
import config from "virtual:starlight/user-config";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

import { site, siteNav } from "../links";

const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <div class="sl-flex print:hidden">{shouldRenderSearch && <Search />}</div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <nav class="site-nav" aria-label="raptorpanel.net">
      {siteNav.map(([path, label]) => <a href={`${site}${path}`}>{label}</a>)}
    </nav>
    <div class="sl-flex social-icons"><SocialIcons /></div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<script>
  // ?q= opens the search with that query: the app's command menu links
  // here with what was typed (docs/PANEL.md#command-menu). Pagefind's box
  // loads lazily, so this waits for it.
  const query = new URLSearchParams(location.search).get("q")?.trim().slice(0, 200);
  if (query) {
    const open = document.querySelector<HTMLButtonElement>("button[data-open-modal]");
    open?.click();
    let tries = 0;
    const fill = () => {
      const input = document.querySelector<HTMLInputElement>("#starlight__search input");
      if (input) {
        input.value = query;
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.focus();
      } else if (tries++ < 50) {
        setTimeout(fill, 100);
      }
    };
    fill();
  }
</script>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: "";
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  /* The site's links, as its header has them: sans, muted, then a rule. */
  .site-nav {
    display: none;
    align-items: center;
    gap: 1.25rem;
    padding-inline-end: 1rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
    height: 2rem;
  }
  .site-nav a {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav a:hover {
    color: var(--sl-color-white);
  }
  @media (min-width: 72rem) {
    .site-nav {
      display: flex;
    }
  }

  @media (min-width: 50rem) {
    :global(:root[data-has-sidebar]) {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
    }
    :global(:root:not([data-has-toc])) {
      --__toc-width: 0rem;
    }
    .header {
      --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
      --__main-column-fr: calc(
        (
            100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
              (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
              var(--sl-content-width)
          ) / 2
      );
      display: grid;
      grid-template-columns:
        minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
        1fr
        auto;
      align-content: center;
    }
  }
</style>
